{
  "format": "osmap.prefab/1",
  "name": "guard_rail",
  "title": "Guard rail",
  "category": "architecture",
  "summary": "A waist-high safety rail with open space between bars. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "length": {
      "default": 384,
      "summary": "Rail length",
      "min": 128,
      "max": 2048
    },
    "height": {
      "default": 112,
      "summary": "Rail height",
      "min": 64,
      "max": 256
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$post1",
      "brush": {
        "size": [
          8,
          8,
          "${height}"
        ]
      },
      "at": [
        0,
        "${-length / 2 + 4}",
        "${height / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$post2",
      "brush": {
        "size": [
          8,
          8,
          "${height}"
        ]
      },
      "at": [
        0,
        "${length / 2 - 4}",
        "${height / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$top",
      "brush": {
        "size": [
          8,
          "${length}",
          8
        ]
      },
      "at": [
        0,
        0,
        "${height - 4}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$middle",
      "brush": {
        "size": [
          6,
          "${length}",
          6
        ]
      },
      "at": [
        0,
        0,
        "${height * .5}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    }
  ]
}
