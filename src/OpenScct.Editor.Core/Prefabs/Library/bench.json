{
  "format": "osmap.prefab/1",
  "name": "bench",
  "title": "Bench",
  "category": "furniture",
  "summary": "A wooden bench with backrest and two supports. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "length": {
      "default": 192,
      "summary": "Seat length",
      "min": 96,
      "max": 1024
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$seat",
      "brush": {
        "size": [
          "${length}",
          48,
          10
        ]
      },
      "at": [
        0,
        0,
        54
      ],
      "csg": "add",
      "mat": "Editor.Kit.Wood"
    },
    {
      "op": "create",
      "id": "$leg1",
      "brush": {
        "size": [
          12,
          40,
          48
        ]
      },
      "at": [
        "${-length / 2 + 24}",
        0,
        24
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$leg2",
      "brush": {
        "size": [
          12,
          40,
          48
        ]
      },
      "at": [
        "${length / 2 - 24}",
        0,
        24
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$back",
      "brush": {
        "size": [
          "${length}",
          8,
          48
        ]
      },
      "at": [
        0,
        24,
        84
      ],
      "csg": "add",
      "mat": "Editor.Kit.Wood"
    }
  ]
}
