{
  "format": "osmap.prefab/1",
  "name": "ladder",
  "title": "Ladder",
  "category": "traversal",
  "summary": "A visible ladder with rungs and a climbable LADDER route. Pivot: floor at the wall foot, climber on +X. Optional custom mesh replaces generated rungs.",
  "params": {
    "height": {
      "default": 384,
      "min": 64,
      "max": 4096,
      "summary": "Height of the climb"
    },
    "offset": {
      "default": 16,
      "min": 0,
      "max": 128,
      "summary": "Distance of the climb line from the wall"
    },
    "mesh": {
      "default": "",
      "summary": "Optional custom ladder model; empty uses generated rails and rungs"
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$climb",
      "ge": "LADDER",
      "points": [
        [
          "${offset}",
          0,
          0
        ],
        [
          "${offset}",
          0,
          "${height}"
        ],
        [
          "${offset + 10}",
          0,
          0
        ]
      ],
      "appearance": "${mesh == ''}"
    },
    {
      "if": "${mesh != ''}",
      "op": "create",
      "id": "$mesh",
      "class": "StaticMeshActor",
      "at": [
        0,
        0,
        0
      ],
      "props": {
        "StaticMesh": "${mesh}"
      }
    }
  ]
}
