{
  "format": "osmap.prefab/1",
  "name": "square_column",
  "title": "Square column",
  "category": "architecture",
  "summary": "A structural column with plinth and capital. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "height": {
      "default": 384,
      "summary": "Height",
      "min": 128,
      "max": 2048
    },
    "width": {
      "default": 64,
      "summary": "Width",
      "min": 32,
      "max": 256
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$column",
      "brush": {
        "size": [
          "${width}",
          "${width}",
          "${height}"
        ]
      },
      "at": [
        0,
        0,
        "${height / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Concrete"
    },
    {
      "op": "create",
      "id": "$base",
      "brush": {
        "size": [
          "${width + 16}",
          "${width + 16}",
          16
        ]
      },
      "at": [
        0,
        0,
        8
      ],
      "csg": "add",
      "mat": "Editor.Kit.Concrete"
    },
    {
      "op": "create",
      "id": "$capital",
      "brush": {
        "size": [
          "${width + 16}",
          "${width + 16}",
          16
        ]
      },
      "at": [
        0,
        0,
        "${height - 8}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Concrete"
    }
  ]
}
