{
  "format": "osmap.prefab/1",
  "name": "service_platform",
  "title": "Service platform",
  "category": "architecture",
  "summary": "A raised industrial deck with four legs. Add stairs or a ladder to reach it. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "length": {
      "default": 384,
      "summary": "Length",
      "min": 128,
      "max": 2048
    },
    "width": {
      "default": 256,
      "summary": "Width",
      "min": 128,
      "max": 1024
    },
    "height": {
      "default": 128,
      "summary": "Height",
      "min": 64,
      "max": 512
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$deck",
      "brush": {
        "size": [
          "${length}",
          "${width}",
          12
        ]
      },
      "at": [
        0,
        0,
        "${height - 6}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$leg0",
      "brush": {
        "size": [
          16,
          16,
          "${height - 12}"
        ]
      },
      "at": [
        "${-1 * (length / 2 - 16)}",
        "${-1 * (width / 2 - 16)}",
        "${(height - 12) / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    },
    {
      "op": "create",
      "id": "$leg1",
      "brush": {
        "size": [
          16,
          16,
          "${height - 12}"
        ]
      },
      "at": [
        "${-1 * (length / 2 - 16)}",
        "${1 * (width / 2 - 16)}",
        "${(height - 12) / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    },
    {
      "op": "create",
      "id": "$leg2",
      "brush": {
        "size": [
          16,
          16,
          "${height - 12}"
        ]
      },
      "at": [
        "${1 * (length / 2 - 16)}",
        "${-1 * (width / 2 - 16)}",
        "${(height - 12) / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    },
    {
      "op": "create",
      "id": "$leg3",
      "brush": {
        "size": [
          16,
          16,
          "${height - 12}"
        ]
      },
      "at": [
        "${1 * (length / 2 - 16)}",
        "${1 * (width / 2 - 16)}",
        "${(height - 12) / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    }
  ]
}
