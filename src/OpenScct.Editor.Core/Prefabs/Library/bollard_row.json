{
  "format": "osmap.prefab/1",
  "name": "bollard_row",
  "title": "Bollard row",
  "category": "exterior",
  "summary": "A row of protective posts for pedestrian routes. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "count": {
      "default": 4,
      "summary": "Number of bollards",
      "min": 1,
      "max": 16
    },
    "spacing": {
      "default": 112,
      "summary": "Spacing",
      "min": 64,
      "max": 256
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$posts",
      "brush": {
        "kind": "cylinder",
        "height": 80,
        "sides": 16,
        "outerRadius": 12
      },
      "at": [
        0,
        "${-(count - 1) * spacing / 2}",
        40
      ],
      "csg": "add",
      "mat": "Editor.Kit.Paint",
      "count": "${count}",
      "step": [
        0,
        "${spacing}",
        0
      ]
    }
  ]
}
