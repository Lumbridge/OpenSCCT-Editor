{
  "format": "osmap.prefab/1",
  "name": "barrel",
  "title": "Industrial barrel",
  "category": "storage",
  "summary": "A capped drum with raised metal rims. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "height": {
      "default": 96,
      "summary": "Height",
      "min": 64,
      "max": 256
    },
    "radius": {
      "default": 32,
      "summary": "Radius",
      "min": 16,
      "max": 96
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$body",
      "brush": {
        "kind": "cylinder",
        "height": "${height}",
        "sides": 16,
        "outerRadius": "${radius}"
      },
      "at": [
        0,
        0,
        "${height / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Paint"
    },
    {
      "op": "create",
      "id": "$rim1",
      "brush": {
        "kind": "cylinder",
        "height": 5,
        "sides": 16,
        "outerRadius": "${radius + 2}"
      },
      "at": [
        0,
        0,
        5
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$rim2",
      "brush": {
        "kind": "cylinder",
        "height": 5,
        "sides": 16,
        "outerRadius": "${radius + 2}"
      },
      "at": [
        0,
        0,
        "${height - 3}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    }
  ]
}
