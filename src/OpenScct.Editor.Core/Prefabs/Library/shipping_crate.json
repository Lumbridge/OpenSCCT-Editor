{
  "format": "osmap.prefab/1",
  "name": "shipping_crate",
  "title": "Shipping crate",
  "category": "storage",
  "summary": "A banded wooden crate for warehouses and cover. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "width": {
      "default": 96,
      "summary": "Crate width",
      "min": 48,
      "max": 512
    },
    "height": {
      "default": 96,
      "summary": "Crate height",
      "min": 48,
      "max": 512
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$body",
      "brush": {
        "size": [
          "${width}",
          "${width}",
          "${height}"
        ]
      },
      "at": [
        0,
        0,
        "${height / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Wood"
    },
    {
      "op": "create",
      "id": "$band0",
      "brush": {
        "size": [
          "${width + 2}",
          "${width + 2}",
          6
        ]
      },
      "at": [
        0,
        0,
        "${height * .18}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$band1",
      "brush": {
        "size": [
          "${width + 2}",
          "${width + 2}",
          6
        ]
      },
      "at": [
        0,
        0,
        "${height * .82}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    }
  ]
}
