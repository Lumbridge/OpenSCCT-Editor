{
  "format": "osmap.prefab/1",
  "name": "ceiling_strip",
  "title": "Ceiling strip light",
  "category": "lighting",
  "summary": "A suspended strip fixture and its editable light. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "length": {
      "default": 192,
      "summary": "Fixture length",
      "min": 96,
      "max": 512
    },
    "height": {
      "default": 256,
      "summary": "Mounting height",
      "min": 128,
      "max": 2048
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$housing",
      "brush": {
        "size": [
          "${length}",
          32,
          12
        ]
      },
      "at": [
        0,
        0,
        "${height}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    },
    {
      "op": "create",
      "id": "$diffuser",
      "brush": {
        "size": [
          "${length - 12}",
          24,
          6
        ]
      },
      "at": [
        0,
        0,
        "${height - 9}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.White"
    },
    {
      "op": "create",
      "id": "$light",
      "class": "Light",
      "at": [
        0,
        0,
        "${height - 28}"
      ],
      "props": {
        "LightBrightness": 176,
        "LightRadius": 32
      }
    }
  ]
}
