{
  "format": "osmap.prefab/1",
  "name": "control_console",
  "title": "Control console",
  "category": "technology",
  "summary": "A freestanding control station with screen and keyboard. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "width": {
      "default": 160,
      "summary": "Console width",
      "min": 96,
      "max": 512
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$base",
      "brush": {
        "size": [
          72,
          "${width}",
          96
        ]
      },
      "at": [
        0,
        0,
        48
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    },
    {
      "op": "create",
      "id": "$desktop",
      "brush": {
        "size": [
          100,
          "${width + 12}",
          8
        ]
      },
      "at": [
        8,
        0,
        100
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$display",
      "brush": {
        "size": [
          8,
          "${width * .8}",
          56
        ]
      },
      "at": [
        -30,
        0,
        134
      ],
      "csg": "add",
      "mat": "Editor.Kit.Screen"
    },
    {
      "op": "create",
      "id": "$keyboard",
      "brush": {
        "size": [
          28,
          "${width * .65}",
          3
        ]
      },
      "at": [
        20,
        0,
        106
      ],
      "csg": "add",
      "mat": "Editor.Kit.White"
    }
  ]
}
