{
  "format": "osmap.prefab/1",
  "name": "wooden_pallet",
  "title": "Wooden pallet",
  "category": "storage",
  "summary": "An open slatted pallet with three runners. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "width": {
      "default": 128,
      "summary": "Width",
      "min": 64,
      "max": 512
    },
    "length": {
      "default": 160,
      "summary": "Length",
      "min": 96,
      "max": 512
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$slat0",
      "brush": {
        "size": [
          "${length}",
          "${width / 7}",
          6
        ]
      },
      "at": [
        0,
        "${width * (0 / 6 - .5) * .84}",
        15
      ],
      "csg": "add",
      "mat": "Editor.Kit.Wood"
    },
    {
      "op": "create",
      "id": "$slat1",
