{
  "format": "osmap.prefab/1",
  "name": "shipping_container",
  "title": "Shipping container",
  "category": "storage",
  "summary": "A closed corrugated cargo container for yards and warehouses; solid cover. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "length": {
      "default": 640,
      "summary": "Length",
      "min": 320,
      "max": 2048
    },
    "width": {
      "default": 256,
      "summary": "Width",
      "min": 128,
      "max": 512
    },
    "height": {
      "default": 256,
      "summary": "Height",
      "min": 192,
      "max": 512
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$shell",
      "brush": {
        "size": [
          "${length}",
          "${width}",
          "${height}"
        ]
      },
      "at": [
        0,
        0,
        "${height / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$rib0",
      "brush": {
        "size": [
          8,
          "${width + 4}",
          "${height + 4}"
        ]
      },
      "at": [
        "${length * (0 / 8 - .5) * .96}",
        0,
        "${height / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    },
    {
