{
  "format": "osmap.prefab/1",
  "name": "concrete_barrier",
  "title": "Concrete barrier",
  "category": "exterior",
  "summary": "A low traffic barrier with wide foot and painted stripe. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "length": {
      "default": 256,
      "summary": "Barrier length",
      "min": 128,
      "max": 1024
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$foot",
      "brush": {
        "size": [
          64,
          "${length}",
          20
        ]
      },
      "at": [
        0,
        0,
        10
      ],
      "csg": "add",
      "mat": "Editor.Kit.Concrete"
    },
    {
      "op": "create",
      "id": "$wall",
      "brush": {
        "size": [
          32,
          "${length}",
          80
        ]
      },
      "at": [
        0,
        0,
        60
      ],
      "csg": "add",
      "mat": "Editor.Kit.Concrete"
    },
    {
      "op": "create",
      "id": "$stripe",
      "brush": {
        "size": [
          34,
          "${length - 16}",
          12
        ]
      },
      "at": [
        0,
        0,
        88
      ],
      "csg": "add",
      "mat": "Editor.Kit.Paint"
    }
  ]
}
