{
  "format": "osmap.prefab/1",
  "name": "pipe_run",
  "title": "Pipe with brackets",
  "category": "industrial",
  "summary": "A vertical service pipe with three mounting brackets. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "height": {
      "default": 320,
      "summary": "Height",
      "min": 128,
      "max": 2048
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$pipe",
      "brush": {
        "kind": "cylinder",
        "height": "${height}",
        "sides": 16,
        "outerRadius": 10
      },
      "at": [
        0,
        0,
        "${height / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$bracket0",
      "brush": {
        "size": [
          32,
          40,
          8
        ]
      },
      "at": [
        0,
        0,
        "${height * 0.1}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    },
    {
      "op": "create",
      "id": "$bracket1",
      "brush": {
        "size": [
          32,
          40,
          8
        ]
      },
      "at": [
        0,
        0,
        "${height * 0.5}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    },
    {
      "op": "create",
      "id": "$bracket2",
      "brush": {
        "size": [
          32,
          40,
          8
        ]
      },
      "at": [
        0,
        0,
        "${height * 0.9}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    }
  ]
}
