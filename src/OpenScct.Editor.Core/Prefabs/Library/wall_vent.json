{
  "format": "osmap.prefab/1",
  "name": "wall_vent",
  "title": "Wall ventilation grille",
  "category": "industrial",
  "summary": "A wall grille with eight raised slats; decorative, without a passage. Pivot: floor at the centre. Dimensions are in Unreal units; all parts are one linked, undoable instance.",
  "params": {
    "width": {
      "default": 128,
      "summary": "Width",
      "min": 64,
      "max": 512
    },
    "height": {
      "default": 96,
      "summary": "Height",
      "min": 48,
      "max": 256
    }
  },
  "ops": [
    {
      "op": "create",
      "id": "$back",
      "brush": {
        "size": [
          8,
          "${width}",
          "${height}"
        ]
      },
      "at": [
        0,
        0,
        "${height / 2}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Dark"
    },
    {
      "op": "create",
      "id": "$slat0",
      "brush": {
        "size": [
          10,
          "${width - 12}",
          4
        ]
      },
      "at": [
        6,
        0,
        "${height * (0 + 1) / 9}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$slat1",
      "brush": {
        "size": [
          10,
          "${width - 12}",
          4
        ]
      },
      "at": [
        6,
        0,
        "${height * (1 + 1) / 9}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$slat2",
      "brush": {
        "size": [
          10,
          "${width - 12}",
          4
        ]
      },
      "at": [
        6,
        0,
        "${height * (2 + 1) / 9}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
      "op": "create",
      "id": "$slat3",
      "brush": {
        "size": [
          10,
          "${width - 12}",
          4
        ]
      },
      "at": [
        6,
        0,
        "${height * (3 + 1) / 9}"
      ],
      "csg": "add",
      "mat": "Editor.Kit.Metal"
    },
    {
