; Engine configuration file.

config_version=5

[application]

config/name="OpenSCCT Editor"
config/description="Map editor for SCCT Versus and OpenSCCT"
config/icon="res://branding/icon.svg"
config/windows_native_icon="res://branding/icon.ico"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.086, 0.09, 0.106, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="OpenSCCT Editor"
run/low_processor_mode=true

[autoload]

BackgroundWindow="*res://Scripts/Shell/Background/BackgroundWindow.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/subwindows/embed_subwindows=false

[dotnet]

project/assembly_name="OpenScctEditor"

[gui]

common/snap_controls_to_pixels=true

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.075, 0.078, 0.09, 1)
anti_aliasing/quality/msaa_3d=2
