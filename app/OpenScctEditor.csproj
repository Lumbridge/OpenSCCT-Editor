<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>OpenScctEditor</RootNamespace>
    <AssemblyName>OpenScctEditor</AssemblyName>
  </PropertyGroup>
  <!-- Godot builds Debug, ExportDebug or ExportRelease; the libraries know Debug and Release. -->
  <PropertyGroup>
    <EditorLibraryConfiguration Condition="'$(Configuration)' == 'ExportRelease'">Release</EditorLibraryConfiguration>
    <EditorLibraryConfiguration Condition="'$(EditorLibraryConfiguration)' == ''">Debug</EditorLibraryConfiguration>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ProjectReference>
      <SetConfiguration>Configuration=$(EditorLibraryConfiguration)</SetConfiguration>
    </ProjectReference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\OpenScct.Editor.Core\OpenScct.Editor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Use the same simulation and particle geometry as the game, without its full scene or render pipeline. -->
    <Compile Include="$(OpenScctDir)game\Scripts\Render\Particles\ParticleParams.cs;$(OpenScctDir)game\Scripts\Render\Particles\ParticleEmitterSim.cs;$(OpenScctDir)game\Scripts\Render\Particles\ParticleSystemSim.cs;$(OpenScctDir)game\Scripts\Render\Particles\ParticleGeometry.cs" Link="Shared\Particles\%(Filename)%(Extension)" />
    <Compile Include="$(OpenScctDir)game\Scripts\Space\UeSpace.cs" Link="Shared\UeSpace.cs" />
  </ItemGroup>
</Project>
